{"openapi":"3.1.0","info":{"title":"Mortality Risk Prediction","description":"Predicts the risk of in-hospital death for critically ill adults (SUPPORT2), using data collected around day 3 of the hospital stay.","version":"0.1.0"},"paths":{"/health":{"get":{"summary":"Health","description":"Simple 200 OK check.","operationId":"health_health_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Response Health Health Get"}}}}}}},"/predict":{"post":{"summary":"Predict","description":"Return the in-hospital death probability for one patient.","operationId":"predict_predict_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Patient"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Prediction"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}}},"components":{"schemas":{"HTTPValidationError":{"properties":{"detail":{"items":{"$ref":"#/components/schemas/ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"},"Patient":{"properties":{"age":{"type":"number","maximum":110.0,"minimum":18.0,"title":"Age","description":"Age in years"},"sex":{"type":"string","enum":["male","female"],"title":"Sex"},"race":{"type":"string","enum":["white","black","hispanic","asian","other","unknown"],"title":"Race","default":"unknown"},"edu":{"anyOf":[{"type":"number","maximum":31.0,"minimum":0.0},{"type":"null"}],"title":"Edu","description":"Years of education"},"income":{"type":"string","enum":["under_$11k","$11-$25k","$25-$50k",">$50k","unknown"],"title":"Income","default":"unknown"},"dzgroup":{"type":"string","enum":["arf/mosf_w/sepsis","mosf_w/malig","chf","copd","cirrhosis","lung_cancer","colon_cancer","coma"],"title":"Dzgroup